aws_region      = "ap-southeast-1"
aws_profile     = "ostad"
github_repo     = "your-github-user/three-tier-terraform"
github_branches = ["main"]
# gh api repos/OWNER/REPO/actions/oidc/customization/sub --jq .sub_claim_prefix
github_immutable_sub_prefix = ""
# false if your AWS account already has the GitHub OIDC provider
create_github_oidc_provider = true
